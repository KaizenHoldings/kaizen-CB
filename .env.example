# ---------------------------------------------------------------------------
# Kaizen Casa de Bolsa — variables de entorno
# Copia este archivo como `.env` y completa los valores reales.
# `.env` está en .gitignore y NUNCA debe subirse al control de versiones.
# ---------------------------------------------------------------------------

# --- Base de datos (obligatorio, solo servidor) ----------------------------
# Cadena de conexión de PostgreSQL usada por @payloadcms/db-postgres.
DATABASE_URI=postgres://usuario:contrasena@127.0.0.1:5432/nombre_base

# --- Payload (obligatorio, solo servidor) ----------------------------------
# Cadena aleatoria larga. Genera una con: openssl rand -hex 32
PAYLOAD_SECRET=

# --- URL pública (obligatorio) ---------------------------------------------
# Origen absoluto del sitio. En desarrollo: http://localhost:3000
# En producción, el dominio real una vez confirmado.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Proveedor de datos de mercado / Banco Central (opcional, pendiente) ----
# Mientras no exista una fuente oficial confirmada, deja ambas vacías: la cinta
# mostrará un estado de "información no disponible" en lugar de cifras falsas.
# Valores admitidos por MARKET_DATA_PROVIDER: `unavailable` | `mock` | `bcv`
# `mock` solo funciona fuera de producción y se rotula como dato simulado.
MARKET_DATA_PROVIDER=unavailable
BCV_API_URL=
BCV_API_KEY=

# --- Audiencia del newsletter · Mailchimp (solo servidor) ------------------
# Las tres son necesarias para dar de alta suscriptores. Si falta cualquiera,
# la suscripción se guarda en Payload pero el formulario responde que no se
# pudo registrar, en vez de dar por buena un alta que nunca ocurrió.
# SERVER_PREFIX es el centro de datos que aparece al final de la clave y en la
# URL del panel: `us21`, `us14`…
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# --- Correo saliente · Microsoft Graph (solo servidor) ---------------------
# Registro de aplicación en Entra ID con el permiso de APLICACIÓN `Mail.Send`
# concedido por un administrador. Sin las cuatro, el formulario de contacto
# responde que no se pudo enviar en vez de dar por entregado un mensaje que
# nadie recibió.
# SENDER_EMAIL es el buzón desde el que sale el correo (UPN o dirección).
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=

# Buzón que recibe los mensajes del formulario de contacto.
CONTACT_FORM_RECIPIENT=

# --- Proveedor de correo (opcional, pendiente de definición) ---------------
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Almacenamiento de archivos en producción (opcional, pendiente) --------
# Sin estas variables los archivos se guardan en disco local (solo desarrollo).
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
